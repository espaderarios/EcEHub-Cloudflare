{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecehub-community",
  "main": "src/community-worker.js",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ecehub-community",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
